{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whoops.local/contracts/api-response.schema.json",
  "title": "API success envelope",
  "type": "object",
  "required": ["data", "meta"],
  "additionalProperties": false,
  "properties": {
    "data": {},
    "meta": {
      "$ref": "#/$defs/metadata"
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["requestId"],
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
