{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whoops.local/contracts/workout-parser.schema.json",
  "title": "Workout parser result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "rawText",
    "format",
    "intendedStimulus",
    "segments",
    "ambiguities",
    "parserConfidence",
    "parserVersion"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "rawText": { "type": "string", "minLength": 1 },
    "format": {
      "enum": ["for_time", "amrap", "emom", "rounds", "strength", "intervals", "manual"]
    },
    "timeCapSeconds": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "reportedResult": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["completedRounds", "additionalRepetitions"],
      "properties": {
        "completedRounds": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "additionalRepetitions": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "intendedStimulus": { "$ref": "#/$defs/stimulus" },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/segment" }
    },
    "ambiguities": {
      "type": "array",
      "items": { "$ref": "#/$defs/ambiguity" }
    },
    "parserConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "parserVersion": { "type": "string", "minLength": 1 },
    "modelVersion": { "type": ["string", "null"], "minLength": 1 }
  },
  "$defs": {
    "stimulus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary"
      ],
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "secondary": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "estimatedDurationMinimumMinutes": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "estimatedDurationMaximumMinutes": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "originalText", "message"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "originalText": { "type": "string" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "type",
        "notes",
        "movements"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["work", "rest", "warmup", "cooldown"] },
        "rounds": { "type": ["integer", "null"], "minimum": 1 },
        "durationSeconds": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "restSeconds": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "notes": { "type": "string" },
        "movements": {
          "type": "array",
          "items": { "$ref": "#/$defs/movement" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "rest" } },
            "required": ["type"]
          },
          "then": {
            "required": ["durationSeconds"],
            "properties": {
              "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
              "rounds": { "type": "null" },
              "restSeconds": { "type": "null" },
              "movements": { "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "movements": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "originalText",
        "notes"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "canonicalMovementID": { "type": ["string", "null"], "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "originalText": { "type": "string" },
        "repetitions": { "type": ["integer", "null"], "minimum": 1 },
        "distanceMeters": { "type": ["integer", "null"], "minimum": 1 },
        "calories": { "type": ["integer", "null"], "minimum": 1 },
        "loadValue": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "loadUnit": { "type": ["string", "null"], "minLength": 1 },
        "percentageOfOneRepMax": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "durationSeconds": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "tempo": { "type": ["string", "null"], "minLength": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
