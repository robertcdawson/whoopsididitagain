# WHOOP OAuth (Milestone 1)
WHOOP_CLIENT_ID=replace_with_whoop_client_id
WHOOP_CLIENT_SECRET=replace_with_whoop_client_secret
WHOOP_REDIRECT_URI=http://localhost:3000/api/v1/auth/whoop/callback

# Backend persistence and security (Milestone 1)
# Leave DATABASE_URL unset for the ephemeral development store.
# DATABASE_URL=postgresql://user:password@localhost:5432/whoops
OAUTH_ENCRYPTION_KEY=replace_with_32_byte_base64_key
APP_SESSION_SIGNING_KEY=replace_with_high_entropy_signing_key
APP_DEEP_LINK=whoops://oauth/callback

# Optional LLM features (Milestone 4+)
LLM_API_KEY=replace_only_when_llm_features_are_enabled
